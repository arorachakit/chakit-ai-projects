{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
      "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@chakit/ui": ["packages/ui/src/index.ts"],
      "@chakit/config/*": ["packages/config/*"]
    },
    "types": ["node"]
  }
}
